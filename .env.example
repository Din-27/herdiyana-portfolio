# SMTP Mailer Configuration
# Ganti dengan kredensial SMTP Anda (misal: Gmail, Resend, Sendgrid, dsb.)

# Host SMTP (default: smtp.gmail.com)
SMTP_HOST=smtp.gmail.com

# Port SMTP (465 untuk SSL, 587 untuk TLS)
SMTP_PORT=465
SMTP_SECURE=true

# Alamat email pengirim SMTP (misal: email Gmail Anda)
SMTP_USER=herdiyanafirmansyah27@gmail.com

# App Password / Kata Sandi Aplikasi (bukan password akun biasa, buat di Google Account -> Security -> App Passwords)
SMTP_PASS=your-16-character-app-password

# Email penerima notifikasi pesan kontak (opsional, default sama dengan SMTP_USER)
CONTACT_RECEIVER_EMAIL=herdiyanafirmansyah27@gmail.com
